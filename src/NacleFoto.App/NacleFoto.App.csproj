<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NacleFoto</AssemblyName>
    <RootNamespace>NacleFoto.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NacleFoto.Core\NacleFoto.Core.csproj" />
    <ProjectReference Include="..\NacleFoto.Windows\NacleFoto.Windows.csproj" />
  </ItemGroup>

</Project>
