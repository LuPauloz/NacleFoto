<Window x:Class="NacleFoto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NacleFoto.App.Views"
        Title="Nacle Foto" Height="860" Width="1380" MinHeight="620" MinWidth="1024"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Fundo}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <views:ProjectsView x:Name="TelaProjetos" />
        <views:SelectionView x:Name="TelaSelecao" Visibility="Collapsed" />
    </Grid>
</Window>
