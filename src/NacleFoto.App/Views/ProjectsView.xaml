<UserControl x:Class="NacleFoto.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NacleFoto.App.Localization"
             Background="{StaticResource Fundo}">
    <Grid Margin="30,24,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc app.name}" Foreground="{StaticResource Texto}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc projects.subtitle}" Style="{StaticResource Subtitulo}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- primary action -->
        <StackPanel Grid.Row="1" Margin="0,22,0,18" MaxWidth="520" HorizontalAlignment="Left">
            <Button x:Name="BtnNewSelection" Content="{loc:Loc btn.newSelection}" Style="{StaticResource BotaoGrande}" Click="BtnNewSelection_Click" HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Subtitulo}" Margin="2,10,0,0" TextWrapping="Wrap"
                       Text="{loc:Loc projects.hint}" />
        </StackPanel>

        <!-- list -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Top" Margin="4,10,0,0"
                       Foreground="{StaticResource Texto2}" FontSize="15" TextWrapping="Wrap"
                       Text="{loc:Loc projects.empty}" />
            <ListBox x:Name="List" ItemContainerStyle="{StaticResource ItemLista}" SelectionMode="Extended"
                     MouseDoubleClick="List_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Texto}"
                                           FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DateText}" Style="{StaticResource Rotulo}" Margin="0,2,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding SelectedText}" Style="{StaticResource Valor}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Valor}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Wedding.Client}" Style="{StaticResource Valor}" VerticalAlignment="Center" />

                            <Border Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{Binding StateBrush}" CornerRadius="10" Padding="10,4">
                                <TextBlock Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#101317" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnOpen" Content="{loc:Loc btn.openSelection}" Style="{StaticResource Botao}" Click="BtnOpen_Click" />
                <Button x:Name="BtnSend" Content="{loc:Loc send.sendSelected}" Style="{StaticResource BotaoPrincipal}" Click="BtnSend_Click" Margin="8,0,0,0" />
                <Button x:Name="BtnRemove" Content="{loc:Loc btn.removeFromList}" Style="{StaticResource Botao}" Click="BtnRemove_Click" Margin="8,0,0,0" />
                <Button x:Name="BtnSettings" Content="{loc:Loc settings.title}" Style="{StaticResource Botao}" Click="BtnSettings_Click" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="ItemCount" Style="{StaticResource Subtitulo}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
