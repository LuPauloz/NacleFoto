<Window x:Class="NacleFoto.App.Views.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NacleFoto.App.Localization"
        Title="WhatsApp" Width="440" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Fundo}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24">
        <TextBlock Text="{loc:Loc qr.title}" Foreground="{StaticResource Texto}" FontSize="19" FontWeight="SemiBold" />
        <TextBlock x:Name="TxtStatus" Style="{StaticResource Subtitulo}" Margin="0,6,0,14" TextWrapping="Wrap" />

        <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Center">
            <Image x:Name="ImgQr" Width="320" Height="320" Stretch="Uniform" />
        </Border>

        <TextBlock Style="{StaticResource Rotulo}" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   Text="{loc:Loc qr.hint}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="BtnAtualizar" Content="{loc:Loc qr.refresh}" Style="{StaticResource Botao}" Click="BtnRefresh_Click" />
            <Button Content="{loc:Loc app.close}" Style="{StaticResource Botao}" Click="BtnFechar_Click" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
