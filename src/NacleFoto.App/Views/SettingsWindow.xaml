<Window x:Class="NacleFoto.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NacleFoto.App.Localization"
        Title="Configuracoes" Width="660" Height="900" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Fundo}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- language -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc settings.language}" Style="{StaticResource Rotulo}" />
            <ComboBox x:Name="ComboLanguage" FontSize="14" Height="34" />
            <TextBlock Text="{loc:Loc settings.readmeLanguage}" Style="{StaticResource Rotulo}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- phone -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc settings.phone}" Style="{StaticResource Rotulo}" />
            <TextBox x:Name="CampoPhone" Style="{StaticResource Caixa}" FontSize="15" />
            <TextBlock Text="{loc:Loc settings.phoneHint}" Style="{StaticResource Rotulo}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- send format -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc settings.format}" Style="{StaticResource Rotulo}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <RadioButton x:Name="RadioZip" GroupName="Formato" Content="{loc:Loc settings.formatZip}" Margin="0,0,18,0" Foreground="{StaticResource Texto}" />
                <RadioButton x:Name="RadioLoose" GroupName="Formato" Content="{loc:Loc settings.formatLoose}" Margin="0,0,18,0" Foreground="{StaticResource Texto}" />
                <RadioButton x:Name="RadioBoth" GroupName="Formato" Content="{loc:Loc settings.formatBoth}" Foreground="{StaticResource Texto}" />
            </StackPanel>
        </StackPanel>

        <!-- part size -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc settings.partSize}" Style="{StaticResource Rotulo}" />
            <TextBox x:Name="CampoPartSize" Style="{StaticResource Caixa}" FontSize="15" Width="120" HorizontalAlignment="Left" />
            <TextBlock Text="{loc:Loc settings.partSizeHint}" Style="{StaticResource Rotulo}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- destination folder -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc settings.destFolder}" Style="{StaticResource Rotulo}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CampoDestino" Grid.Column="0" Style="{StaticResource Caixa}" FontSize="14" />
                <Button Grid.Column="1" Margin="8,0,0,0" Content="..." Style="{StaticResource Botao}" Click="BtnChooseFolder_Click" />
            </Grid>
            <CheckBox x:Name="CheckNuvem" Content="{loc:Loc settings.cloudFiles}" Foreground="{StaticResource Texto}"
                      FontSize="12" Margin="0,8,0,0" />
        </StackPanel>

        <!-- retention + batch -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc settings.retention}" Style="{StaticResource Rotulo}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox x:Name="CampoRetencao" Style="{StaticResource Caixa}" FontSize="15" Width="90" HorizontalAlignment="Left" />
                <TextBlock Text="{loc:Loc settings.retentionDays}" Style="{StaticResource Valor}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{loc:Loc settings.retentionHint}" Style="{StaticResource Rotulo}" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock Text="{loc:Loc settings.message}" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
            <TextBox x:Name="CampoMensagem" Style="{StaticResource Caixa}" FontSize="14" Margin="0,4,0,0" />
            <TextBlock Text="{loc:Loc settings.messageHint}" Style="{StaticResource Rotulo}" Margin="0,4,0,0" TextWrapping="Wrap" />

            <TextBlock Text="{loc:Loc settings.batchSize}" Style="{StaticResource Rotulo}" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox x:Name="CampoLote" Style="{StaticResource Caixa}" FontSize="15" Width="90" HorizontalAlignment="Left" />
                <TextBlock Text="{loc:Loc settings.batchSizeUnit}" Style="{StaticResource Valor}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- download link -->
        <Border Grid.Row="6" Background="{StaticResource Painel2}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="{loc:Loc settings.linkHint}" Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <CheckBox x:Name="CheckUseLink" Content="{loc:Loc settings.linkEnabled}" Foreground="{StaticResource Texto}" Margin="0,0,0,10" />

                <TextBlock Text="{loc:Loc settings.provider}" Style="{StaticResource Rotulo}" />
                <WrapPanel Margin="0,4,0,12">
                    <RadioButton x:Name="RadioNone" GroupName="Provedor" Content="{loc:Loc settings.providerNone}" Margin="0,0,16,6" Foreground="{StaticResource Texto}" Checked="Provider_Changed" />
                    <RadioButton x:Name="RadioSendit" GroupName="Provedor" Content="{loc:Loc settings.providerSendit}" Margin="0,0,16,6" Foreground="{StaticResource Texto}" Checked="Provider_Changed" />
                    <RadioButton x:Name="RadioS3" GroupName="Provedor" Content="{loc:Loc settings.providerS3}" Margin="0,0,16,6" Foreground="{StaticResource Texto}" Checked="Provider_Changed" />
                    <RadioButton x:Name="RadioFolder" GroupName="Provedor" Content="{loc:Loc settings.providerFolder}" Margin="0,0,16,6" Foreground="{StaticResource Texto}" Checked="Provider_Changed" />
                </WrapPanel>

                <!-- sendit -->
                <StackPanel x:Name="PainelSendit" Margin="0,0,0,4" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc settings.senditHint}" Style="{StaticResource Rotulo}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- synced folder -->
                <StackPanel x:Name="PainelFolder" Margin="0,0,0,4" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc settings.syncFolder}" Style="{StaticResource Rotulo}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CampoSyncFolder" Grid.Column="0" Style="{StaticResource Caixa}" FontSize="13" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Content="..." Style="{StaticResource Botao}" Click="BtnEscolherSync_Click" />
                    </Grid>
                    <TextBlock Text="{loc:Loc settings.syncHint}" Style="{StaticResource Rotulo}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
            </StackPanel>
            </Border>

        <!-- WAHA -->
        <Border Grid.Row="6" Background="{StaticResource Painel2}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc settings.waha}" Foreground="{StaticResource Texto}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc settings.wahaHint}" Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,4,0,10" />
                <Button x:Name="BtnGerenciarWaha" Content="{loc:Loc settings.wahaManage}" Style="{StaticResource Botao}" Click="BtnGerenciarWaha_Click" Margin="0,0,8,6" />
                <Button x:Name="BtnQrWaha" Content="{loc:Loc send.pairWhatsapp}" Style="{StaticResource Botao}" Click="BtnQrWaha_Click" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="{loc:Loc settings.wahaUrl}" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="CampoWahaUrl" Style="{StaticResource Caixa}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="{loc:Loc settings.wahaSession}" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="CampoWahaSession" Style="{StaticResource Caixa}" FontSize="13" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc settings.wahaKey}" Style="{StaticResource Rotulo}" Margin="0,8,0,0" />
                <TextBox x:Name="CampoWahaKey" Style="{StaticResource Caixa}" FontSize="13" />

                <CheckBox x:Name="CheckWahaAuto" Content="{loc:Loc settings.wahaAuto}" Foreground="{StaticResource Texto}"
                          FontSize="12" Margin="0,10,0,0" />

                <TextBlock Text="{loc:Loc settings.wahaCommand}" Style="{StaticResource Rotulo}" Margin="0,8,0,0" />
                <TextBox x:Name="CampoWahaComando" Style="{StaticResource Caixa}" FontSize="12" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc app.save}" Style="{StaticResource BotaoPrincipal}" Click="BtnSalvar_Click" MinWidth="120" />
            <Button Content="{loc:Loc app.cancel}" Style="{StaticResource Botao}" Click="BtnCancelar_Click" Margin="8,0,0,0" MinWidth="100" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
