<Window x:Class="NacleFoto.App.Views.ZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NacleFoto.App.Localization"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Normal"
        WindowStartupLocation="CenterOwner"
        Background="#000000" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Background="#000000">
        <Canvas x:Name="Cnv" Background="#000000" ClipToBounds="True"
                MouseWheel="Cnv_MouseWheel" MouseLeftButtonDown="Cnv_MouseLeftButtonDown"
                MouseMove="Cnv_MouseMove" MouseUp="Cnv_MouseUp" Cursor="Hand" />

        <!-- bottom bar -->
        <Border VerticalAlignment="Bottom" Background="#C4000000" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtNome" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="TxtDados" Foreground="#B9C0C8" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMarcar" Content="{loc:Loc zoom.mark}" Style="{StaticResource Botao}"
                            Click="BtnMarcar_Click" Margin="0,0,16,0" MinWidth="110" />
                    <TextBlock x:Name="TxtMarca" Foreground="#37C978" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,16,0" Text="MARCADA" />
                    <TextBlock Foreground="#B9C0C8" FontSize="13" VerticalAlignment="Center"
                               Text="← → navegar   ·   X marcar   ·   Esc sair" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- close button -->
        <Button x:Name="BotaoFechar" Content="X" Width="40" Height="40" FontSize="16" FontWeight="Bold"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                Background="#66000000" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand"
                Click="BtnClose_Click" />
    </Grid>
</Window>
