<Window x:Class="NacleFoto.App.Views.SendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NacleFoto.App.Localization"
        Title="Enviar" Width="820" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Fundo}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Foreground="{StaticResource Texto}" FontSize="20" FontWeight="SemiBold"
                       Text="{loc:Loc send.title}" />
            <TextBlock x:Name="TxtResumo" Style="{StaticResource Subtitulo}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- weddings in this send (pick which ones to send) -->
        <Border Grid.Row="1" Background="{StaticResource Painel2}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{loc:Loc send.whichOnes}" Style="{StaticResource Rotulo}" Margin="0,0,0,6" />
                <ItemsControl x:Name="ListaCasamentos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Send, Mode=TwoWay}" Margin="0,4" Cursor="Hand"
                                      Foreground="{StaticResource Texto}" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Wedding.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Texto2}" Margin="10,0,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- actions -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <WrapPanel>
                <Button x:Name="BtnAutoWhatsapp" Content="{loc:Loc send.autoWhatsapp}" Style="{StaticResource BotaoPrincipal}" Click="BtnAutoWhatsapp_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnLink" Content="{loc:Loc send.generateLink}" Style="{StaticResource Botao}" Click="BtnLink_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnWhatsapp" Content="{loc:Loc send.openChat}" Style="{StaticResource Botao}" Click="BtnWhatsapp_Click" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Rotulo}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="{loc:Loc send.autoWhatsappHint}" />

            <!-- where the photos go (destination number) -->
            <Border Background="{StaticResource Painel2}" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Rotulo}" VerticalAlignment="Center"
                               Text="{loc:Loc send.sendingTo}" />
                    <TextBlock x:Name="TxtDestino" Style="{StaticResource Valor}" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Content="{loc:Loc send.changeNumber}" Style="{StaticResource Botao}"
                            Click="BtnChangeNumber_Click" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- progress / status -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <ProgressBar x:Name="Barra" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{StaticResource Destaque}" />

            <Border x:Name="BlocoStatus" Background="{StaticResource Painel2}" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                <TextBlock x:Name="TxtStatus" Style="{StaticResource Valor}" TextWrapping="Wrap" Foreground="{StaticResource Texto}" />
            </Border>

            <!-- generated link -->
            <StackPanel x:Name="BlocoLink" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="{loc:Loc send.linkReady}" Style="{StaticResource Valor}" TextWrapping="Wrap" />
                <TextBox x:Name="CampoLink" Style="{StaticResource Caixa}" FontSize="12" Margin="0,6,0,0"
                         IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto" />
                <Button x:Name="BtnCopyLink" Content="{loc:Loc btn.copyLink}" Style="{StaticResource Botao}"
                        Click="BtnCopyLink_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="TxtDica" Style="{StaticResource Rotulo}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSent" Content="{loc:Loc btn.markSent}" Style="{StaticResource Botao}" Click="BtnSent_Click" Margin="0,0,8,0" />
                <Button Content="{loc:Loc app.close}" Style="{StaticResource Botao}" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
