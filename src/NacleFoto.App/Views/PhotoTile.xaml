<UserControl x:Class="NacleFoto.App.Views.PhotoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NacleFoto.App.Localization"
             Width="152" Height="152" Background="Transparent"
             MouseLeftButtonUp="Tile_MouseLeftButtonUp"
             MouseRightButtonUp="Tile_MouseRightButtonUp">
    <UserControl.Resources>
        <Style x:Key="BotaoMarcar" TargetType="Button">
            <Setter Property="Background" Value="#B3000000" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Selected}" />
                    <Setter Property="BorderBrush" Value="#062B14" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TracoCheck" TargetType="Path">
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="2.6" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="#062B14" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="#1A1D22" CornerRadius="5" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding Thumb}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- placeholder shown while the thumbnail loads -->
                <TextBlock Text="..." Foreground="#4A515A" FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadingThumbnail}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- technical data stamp -->
                <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="5,2" CornerRadius="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBadge}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Badge, TargetNullValue=''}" Foreground="#E7EAEE" FontSize="10" />
                </Border>
            </Grid>
        </Border>

        <!-- mark / unmark button (clicking the little square) -->
        <Button x:Name="BtnMarcar" Style="{StaticResource BotaoMarcar}"
                Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                Click="BtnMarcar_Click" ToolTip="{loc:Loc tile.markTip}">
            <Path Data="M 4,10 L 9,15 L 18,4" Style="{StaticResource TracoCheck}" />
        </Button>
    </Grid>
</UserControl>
