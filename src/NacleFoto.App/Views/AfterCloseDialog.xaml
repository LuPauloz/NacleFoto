<Window x:Class="NacleFoto.App.Views.AfterCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NacleFoto.App.Localization"
        Title="Nacle Foto" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Fundo}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24">
        <TextBlock Foreground="{StaticResource Texto}" FontSize="19" FontWeight="SemiBold"
                   Text="{loc:Loc after.title}" />
        <TextBlock x:Name="TxtResumo" Style="{StaticResource Subtitulo}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc after.question}" Foreground="{StaticResource Texto}" FontSize="14" Margin="0,18,0,12" />

        <Button x:Name="BtnEnviar" Content="{loc:Loc after.sendNow}" Style="{StaticResource BotaoGrande}"
                HorizontalAlignment="Stretch" Click="BtnSendNow_Click" />
        <Button x:Name="BtnNovo" Content="{loc:Loc after.newSelection}" Style="{StaticResource Botao}"
                HorizontalAlignment="Stretch" Click="BtnNovo_Click" Margin="0,8,0,0" Padding="16,12" FontSize="14" />
        <Button x:Name="BtnDepois" Content="{loc:Loc after.later}" Style="{StaticResource Botao}"
                HorizontalAlignment="Stretch" Click="BtnDepois_Click" Margin="0,8,0,0" Padding="16,10" />
    </StackPanel>
</Window>
